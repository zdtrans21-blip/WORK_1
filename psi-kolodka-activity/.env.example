# --- Runtime (index.js) ---
PORT=3000

# --- install.js (one-time activity registration) ---
# OAuth app key created via POST /v1/apps (vibe_app_...), with scopes
# ["crm", "bizproc", "disk", "vibe:infra"]. Required — neither a personal
# vibe_api_ key nor a classic Bitrix24 incoming webhook can register bizproc
# activities: Bitrix24 itself refuses both with 403 ACCESS_DENIED /
# "Application context required" — bizproc.activity.add needs real
# OAuth-application context.
VIBE_APP_KEY=vibe_app_...
# Public URL of the app, deployed on the infra SERVER BOUND TO THIS SAME
# APP KEY (no trailing slash). install.js appends /handler. Registering
# with a handler on a server bound to a different app/key fails with
# 400 SERVER_APP_MISMATCH.
APP_URL=https://app-xxxx.bitrix24.tech
# Optional: paste a still-valid session token (from a previous OAuth authorize)
# to skip the interactive browser step. Sessions expire after 24h.
VIBE_APP_SESSION_TOKEN=

# --- scripts/testRecognition.js ---
TEST_LLM_URL=https://api.openai.com/v1/chat/completions
TEST_LLM_MODEL=gpt-4o
TEST_LLM_KEY=sk-...
